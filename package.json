{
  "name": "fomo-club",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared",
    "packages/lab"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm --workspace @fomo/legacy-paper-api run build",
    "build:shared": "npm --workspace @fomo/shared run build",
    "build:web": "npm --workspace @fomo/backend run build",
    "ci": "npm run lint && npm run typecheck && npm run build",
    "clean:web": "npm --workspace @fomo/backend run clean",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "npm --workspace @fomo/legacy-paper-api run dev",
    "dev:web": "npm --workspace @fomo/backend run dev",
    "dev:worker": "npm --workspace @fomo/legacy-paper-api run worker:dev",
    "lab:backtest": "tsx scripts/lab/backtest.ts",
    "lab:benchmark": "tsx scripts/lab/collect-benchmark.ts",
    "lab:candles": "tsx scripts/lab/collect-candles.ts",
    "lab:compare": "tsx scripts/lab/compare-paper.ts",
    "lab:fce-upload": "tsx scripts/lab/fce-upload.ts",
    "lab:funding": "tsx scripts/lab/collect-funding.ts",
    "lab:import-ledger": "tsx scripts/lab/import-judgment-ledger.ts",
    "lab:latest": "tsx scripts/lab/collect-latest.ts",
    "lab:measure": "tsx scripts/lab/measure-indicators.ts",
    "lab:migrate": "prisma migrate deploy",
    "lab:migrate:verify": "tsx scripts/lab/migrate-verify.ts",
    "lab:paper": "tsx scripts/lab/paper-tick.ts",
    "lab:runner": "tsx scripts/lab/runner.ts",
    "lab:seed-strategy": "tsx scripts/lab/seed-strategy.ts",
    "lab:sweep": "tsx scripts/lab/sweep-parameters.ts",
    "lab:verify-alert": "tsx scripts/lab/verify-alert.ts",
    "lab:verify-collect": "tsx scripts/lab/verify-collect.ts",
    "lab:verify-engine": "tsx scripts/lab/verify-engine.ts",
    "lab:verify-live": "tsx scripts/lab/verify-live.ts",
    "lab:verify-paper": "tsx scripts/lab/verify-paper.ts",
    "lab:verify-store": "tsx scripts/lab/verify-strategy-store.ts",
    "lab:whale": "tsx scripts/lab/collect-whale.ts",
    "lint": "npm run lint --workspaces --if-present",
    "lint:api": "npm --workspace @fomo/legacy-paper-api run lint",
    "lint:web": "npm --workspace @fomo/backend run lint",
    "paper:status": "tsx scripts/paper-status.ts",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "qa:screenshot": "tsx scripts/qa-screenshot.ts",
    "reset:web": "npm run clean:web && npm run dev:web",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:scripts",
    "typecheck:api": "npm --workspace @fomo/legacy-paper-api run typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:web": "npm --workspace @fomo/backend run typecheck",
    "lab:discard": "tsx scripts/lab/discard-strategies.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "prisma": "^5.22.0",
    "react": "^19.2.7",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@react-native-seoul/kakao-login": "^5.4.2",
    "@react-native-seoul/naver-login": "^4.2.4",
    "expo-secure-store": "^55.0.14"
  }
}
