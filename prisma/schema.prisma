generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BotStatus {
  RUNNING
  STOPPED
  DEGRADED
}

enum StrategyStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum StrategyRunStatus {
  SIGNAL
  NO_SIGNAL
  ERROR
  SKIPPED
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum OrderRole {
  MAKER
  TAKER
}

enum TradeAction {
  BUY
  SELL
  CLOSE
  STOP_LOSS
  TAKE_PROFIT
}

enum AlertType {
  ENTRY
  EXIT
  STOP_LOSS
  TAKE_PROFIT
  ERROR
  INFO
  RESTART
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

enum SystemLogLevel {
  INFO
  WARN
  ERROR
}

enum StrategySessionStatus {
  ACTIVE
  ARCHIVED
}

enum NewsletterDigestStatus {
  DRAFT
  GENERATED
  SENT
  FAILED
}

// ─── Tarot 앱 전용 enum ───────────────────────────────────────────────────────

enum TarotAuthProvider {
  APPLE
  GOOGLE
  KAKAO
  NAVER
}

enum TarotMembershipStatus {
  FREE
  PRO
}

enum TarotSpreadType {
  SINGLE
  THREE_CARD
}

enum TarotMarket {
  US
  KR
}

enum TarotInterpretationSource {
  LLM
  CACHE
  FALLBACK
}

enum TarotCreditReason {
  SIGNUP_BONUS
  PURCHASE
  REWARD_AD
  REWARD_SHARE
  DRAW_SINGLE
  DRAW_THREE
  REFUND
  STREAK_REWARD
}

enum TarotDisclaimerVersion {
  V1
}

enum TarotFeedbackRating {
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

enum TarotReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

enum TarotCardStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                 String                  @id @default(cuid())
  email              String?                 @unique
  passwordHash       String?
  displayName        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  // 타로 앱 전용 필드
  authProvider       TarotAuthProvider?
  authProviderId     String?
  membershipStatus   TarotMembershipStatus   @default(FREE)
  pushToken          String?
  disclaimerVersion  TarotDisclaimerVersion?
  disclaimerAgreedAt DateTime?
  // 연속 로그인 스트릭
  streakCount        Int                     @default(0)
  streakLastDate     DateTime?
  // 관계
  bots               Bot[]
  researchProfile    ResearchProfile?
  agentThreads       AgentMeetingThread[]
  creditLedger       TarotCreditLedger[]
  drawHistory        TarotDrawHistory[]
  favorites          TarotFavorite[]
  feedbacks          TarotFeedback[]
  reports            TarotReport[]
  cardCollection     TarotCardCollection[]
  analyticsEvents    TarotAnalyticsEvent[]
  tasteSignals       TasteSignal[]

  @@unique([authProvider, authProviderId])
  @@index([authProvider, authProviderId])
}

model Bot {
  id                     String            @id @default(cuid())
  userId                 String?
  name                   String
  mode                   String            @default("paper")
  status                 BotStatus         @default(STOPPED)
  exchangeKey            String            @default("mock-binance-futures")
  baseAsset              String            @default("USDT")
  paperBalance           Float             @default(10000)
  reservedBalance        Float             @default(0)
  makerFeeRate           Float             @default(0.0002)
  takerFeeRate           Float             @default(0.0005)
  entryOrderRole         OrderRole         @default(TAKER)
  exitOrderRole          OrderRole         @default(TAKER)
  slippageBps            Float             @default(4)
  heartbeatAt            DateTime?
  lastErrorAt            DateTime?
  lastDailyReportSentAt  DateTime?
  lastWeeklyReportSentAt DateTime?
  metadata               Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  user                   User?             @relation(fields: [userId], references: [id])
  strategies             LegacyStrategy[]
  sessions               StrategySession[]
  strategyRuns           StrategyRun[]
  positions              Position[]
  trades                 LegacyTrade[]
  alerts                 Alert[]
  dailySummaries         DailySummary[]
  systemLogs             SystemLog[]

  @@index([userId])
}

model LegacyStrategy {
  id              String         @id @default(cuid())
  botId           String
  key             String
  name            String
  description     String?
  status          StrategyStatus @default(PAUSED)
  symbol          String
  timeframe       String         @default("15m")
  config          Json
  lastEvaluatedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  bot             Bot            @relation(fields: [botId], references: [id])
  runs            StrategyRun[]
  positions       Position[]
  trades          LegacyTrade[]
  alerts          Alert[]

  @@unique([botId, key])
}

model StrategySession {
  id             String                @id @default(cuid())
  botId          String
  name           String
  runLabel       String
  status         StrategySessionStatus @default(ACTIVE)
  notes          String?
  configSnapshot Json?
  startedAt      DateTime              @default(now())
  endedAt        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  bot            Bot                   @relation(fields: [botId], references: [id])
  strategyRuns   StrategyRun[]
  positions      Position[]
  trades         LegacyTrade[]
  alerts         Alert[]
  dailySummaries DailySummary[]

  @@index([botId, status, startedAt])
}

model DailySummary {
  id                     String           @id @default(cuid())
  botId                  String
  sessionId              String?
  scopeKey               String           @unique
  dateKey                String
  timezone               String
  sessionName            String?
  runLabel               String?
  tradeCount             Int              @default(0)
  closedPositionCount    Int              @default(0)
  winCount               Int              @default(0)
  lossCount              Int              @default(0)
  grossPnl               Float            @default(0)
  netPnl                 Float            @default(0)
  totalFees              Float            @default(0)
  totalWinningPnl        Float            @default(0)
  totalLosingPnl         Float            @default(0)
  bestTrade              Float            @default(0)
  worstTrade             Float            @default(0)
  strategyPerformance    Json
  entryReasonPerformance Json
  exitReasonPerformance  Json
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  bot                    Bot              @relation(fields: [botId], references: [id])
  session                StrategySession? @relation(fields: [sessionId], references: [id])

  @@index([botId, dateKey])
  @@index([sessionId, dateKey])
}

model StrategyRun {
  id                String            @id @default(cuid())
  botId             String
  strategyId        String
  sessionId         String?
  runLabel          String?
  symbol            String
  timeframe         String
  status            StrategyRunStatus
  signalType        String
  price             Float?
  primaryReasonCode String?
  primaryReasonText String?
  reasonsText       String?
  reasons           Json?
  indicators        Json?
  errorMessage      String?
  executedAt        DateTime          @default(now())
  bot               Bot               @relation(fields: [botId], references: [id])
  strategy          LegacyStrategy    @relation(fields: [strategyId], references: [id])
  session           StrategySession?  @relation(fields: [sessionId], references: [id])

  @@index([botId])
  @@index([strategyId])
  @@index([sessionId, executedAt])
}

model Position {
  id              String           @id @default(cuid())
  botId           String
  strategyId      String?
  sessionId       String?
  symbol          String
  side            String           @default("LONG")
  status          PositionStatus   @default(OPEN)
  quantity        Float
  entryPrice      Float
  exitPrice       Float?
  entryValue      Float
  exitValue       Float?
  realizedPnl     Float            @default(0)
  unrealizedPnl   Float            @default(0)
  feesPaid        Float            @default(0)
  openedAt        DateTime         @default(now())
  closedAt        DateTime?
  entryReasonCode String
  entryReasonText String
  entryReasonMeta Json
  exitReasonCode  String?
  exitReasonText  String?
  exitReasonMeta  Json?
  bot             Bot              @relation(fields: [botId], references: [id])
  strategy        LegacyStrategy?  @relation(fields: [strategyId], references: [id])
  session         StrategySession? @relation(fields: [sessionId], references: [id])
  trades          LegacyTrade[]

  @@index([botId, symbol, status])
  @@index([strategyId])
  @@index([sessionId, status])
}

model LegacyTrade {
  id              String           @id @default(cuid())
  botId           String
  strategyId      String?
  positionId      String?
  sessionId       String?
  symbol          String
  action          TradeAction
  side            String           @default("LONG")
  quantity        Float
  price           Float
  notional        Float
  orderRole       OrderRole
  feeRate         Float
  slippageBps     Float            @default(0)
  fee             Float            @default(0)
  grossPnl        Float            @default(0)
  realizedPnl     Float            @default(0)
  reasonCode      String
  reasonText      String
  reasonMeta      Json
  executedAt      DateTime         @default(now())
  externalOrderId String?
  bot             Bot              @relation(fields: [botId], references: [id])
  strategy        LegacyStrategy?  @relation(fields: [strategyId], references: [id])
  position        Position?        @relation(fields: [positionId], references: [id])
  session         StrategySession? @relation(fields: [sessionId], references: [id])

  @@index([botId, executedAt])
  @@index([strategyId])
  @@index([positionId])
  @@index([sessionId, executedAt])
}

model Alert {
  id         String           @id @default(cuid())
  botId      String
  strategyId String?
  sessionId  String?
  type       AlertType
  status     AlertStatus      @default(PENDING)
  title      String
  message    String
  payload    Json?
  sentAt     DateTime?
  createdAt  DateTime         @default(now())
  bot        Bot              @relation(fields: [botId], references: [id])
  strategy   LegacyStrategy?  @relation(fields: [strategyId], references: [id])
  session    StrategySession? @relation(fields: [sessionId], references: [id])

  @@index([botId])
  @@index([strategyId])
  @@index([sessionId])
}

model MarketCandle {
  id          String   @id @default(cuid())
  exchangeKey String
  symbol      String
  timeframe   String
  openTime    DateTime
  closeTime   DateTime
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Float
  createdAt   DateTime @default(now())

  @@unique([exchangeKey, symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime])
}

model SystemLog {
  id        String         @id @default(cuid())
  botId     String?
  level     SystemLogLevel
  source    String
  message   String
  context   Json?
  createdAt DateTime       @default(now())
  bot       Bot?           @relation(fields: [botId], references: [id])

  @@index([botId])
  @@index([createdAt])
}

model ResearchProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  preferredSectors  Json
  preferredTickers  Json
  newsletterEnabled Boolean            @default(true)
  newsletterEmail   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id])
  newsletters       NewsletterDigest[]
}

model ResearchNews {
  id              String   @id @default(cuid())
  title           String
  summary         String
  source          String?
  sectorTag       String
  tickerTags      Json
  importanceScore Float    @default(0)
  analysis        String
  recommendation  String
  publishedAt     DateTime
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sectorTag, importanceScore])
  @@index([publishedAt])
}

model TickerInsight {
  id                String   @id @default(cuid())
  ticker            String
  company           String?
  sectorTag         String
  importanceScore   Float    @default(0)
  summary           String
  technicalAnalysis String
  patternAnalysis   Json
  marketContext     String
  recommendation    String
  linkedNewsIds     Json
  generatedAt       DateTime @default(now())
  metadata          Json?

  @@index([ticker, generatedAt])
  @@index([sectorTag, importanceScore])
}

model NewsletterDigest {
  id           String                 @id @default(cuid())
  profileId    String?
  cadence      String                 @default("daily")
  status       NewsletterDigestStatus @default(GENERATED)
  subject      String
  previewText  String
  payload      Json
  htmlBody     String?
  textBody     String?
  generatedAt  DateTime               @default(now())
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  profile      ResearchProfile?       @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@index([generatedAt])
  @@index([status, scheduledFor])
}

model AgentMeetingThread {
  id         String                @id @default(cuid())
  userId     String?
  topic      String
  objective  String
  nextAction String
  context    Json?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  user       User?                 @relation(fields: [userId], references: [id])
  messages   AgentMeetingMessage[]

  @@index([userId, createdAt])
}

model AgentMeetingMessage {
  id         String             @id @default(cuid())
  threadId   String
  role       String
  author     String
  content    String
  references Json?
  position   Int
  createdAt  DateTime           @default(now())
  thread     AgentMeetingThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, position])
  @@index([threadId, createdAt])
}

// ─── Tarot 앱 전용 모델 ───────────────────────────────────────────────────────

// 타로 카드 메타데이터 (어드민이 관리)
model TarotCard {
  id               String                 @id
  name             String
  nameKo           String
  arcana           String                 @default("major")
  number           Int
  keywords         Json
  keywordsKo       Json
  meaningUpright   String
  meaningReversed  String
  imageUrl         String
  toneGuide        String
  status           TarotCardStatus        @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  drawHistoryCards TarotDrawHistoryCard[]
  collections      TarotCardCollection[]
}

// 크레딧(뽑기권) 원장 — insert-only, 잔액은 SUM(amount)로 계산
model TarotCreditLedger {
  id          String            @id @default(cuid())
  userId      String
  amount      Int // 양수: 충전, 음수: 차감
  reason      TarotCreditReason
  referenceId String? // 결제 ID, 광고 세션 ID 등
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// 뽑기 기록
model TarotDrawHistory {
  id             String                    @id @default(cuid())
  userId         String
  ticker         String
  market         TarotMarket
  spread         TarotSpreadType
  headline       String
  summary        String
  detail         String
  source         TarotInterpretationSource
  idempotencyKey String                    @unique
  creditCost     Int
  cacheKey       String?
  createdAt      DateTime                  @default(now())
  user           User                      @relation(fields: [userId], references: [id])
  cards          TarotDrawHistoryCard[]
  feedbacks      TarotFeedback[]
  reports        TarotReport[]

  @@index([userId, createdAt])
  @@index([ticker, createdAt])
}

// 뽑기 결과에 포함된 카드 목록 (1장 또는 3장)
model TarotDrawHistoryCard {
  id          String           @id @default(cuid())
  drawId      String
  cardId      String
  orientation String // "upright" | "reversed"
  slot        String? // "past" | "present" | "future" (3장 스프레드)
  position    Int // 순서
  draw        TarotDrawHistory @relation(fields: [drawId], references: [id], onDelete: Cascade)
  card        TarotCard        @relation(fields: [cardId], references: [id])

  @@index([drawId])
  @@index([cardId])
}

// 관심 종목/섹터 즐겨찾기
model TarotFavorite {
  id           String      @id @default(cuid())
  userId       String
  ticker       String
  market       TarotMarket
  label        String? // 표시명 (예: "삼성전자")
  alertEnabled Boolean     @default(false)
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id])

  @@unique([userId, ticker])
  @@index([userId])
}

// 해석 피드백 (만족도)
model TarotFeedback {
  id        String              @id @default(cuid())
  userId    String
  drawId    String
  rating    TarotFeedbackRating
  comment   String?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id])
  draw      TarotDrawHistory    @relation(fields: [drawId], references: [id])

  @@unique([userId, drawId])
  @@index([drawId])
}

// 부적절한 콘텐츠 신고
model TarotReport {
  id        String            @id @default(cuid())
  userId    String
  drawId    String
  reason    String
  status    TarotReportStatus @default(PENDING)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id])
  draw      TarotDrawHistory  @relation(fields: [drawId], references: [id])

  @@index([userId])
  @@index([drawId])
  @@index([status, createdAt])
}

// 프롬프트 버전 이력 (어드민 관리)
model TarotPromptVersion {
  id          String    @id @default(cuid())
  version     String    @unique // "1.0.0"
  content     String
  isActive    Boolean   @default(false)
  activatedAt DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

// 카드 컬렉션/도감 — 사용자가 수집한 카드 기록
model TarotCardCollection {
  id           String    @id @default(cuid())
  userId       String
  cardId       String // TarotCard.id 참조
  firstDrawnAt DateTime  @default(now())
  drawCount    Int       @default(1)
  user         User      @relation(fields: [userId], references: [id])
  card         TarotCard @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}

// 모바일 앱 이벤트 트래킹
model TarotAnalyticsEvent {
  id              String   @id @default(cuid())
  userId          String
  event           String // e.g. "draw_start", "ad_earned", "iap_complete"
  properties      Json     @default("{}")
  clientTimestamp DateTime
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Admin 보안 모델 (Phase 1)
// ─────────────────────────────────────────────

// 로그인 시도 기록 — 브루트포스 방어용
model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

// 어드민 액션 감사 로그 — 모든 변경 사항 기록
model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String // "card.update", "prompt.activate", "report.resolve" 등
  targetId   String?
  targetType String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
}

// 전역 세션 무효화 타임스탬프 — 비밀번호 변경 시 모든 세션 일괄 만료
model AdminSessionConfig {
  id                String   @id @default("singleton")
  invalidatedBefore DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─────────────────────────────────────────────
// FOMO Club (Phase 2) — 감정 집계 + FOMO Index 스냅샷
// docs/FOMO_CLUB.md, docs/FOMO_INDEX.md 참조. 익명 세션 기반, 무가입 허용.
// ─────────────────────────────────────────────

// 익명 감정 투표 — 웹/앱 공통, 1세션 1일 1회
model EmotionVote {
  id           String   @id @default(cuid())
  sessionId    String // 익명 세션 (웹: localStorage, 앱: 디바이스 ID)
  userId       String? // 가입자만 (선택)
  emotion      String // "fomo"|"fear"|"regret"|"greed"|"conviction"
  source       String // "web"|"mobile"
  votedDate    String // YYYY-MM-DD (1일 1회 제한용)
  // M4 구조화 한마디 (optional opt-in) — 키는 @fomo/core voices.ts 선택지만 허용
  situationKey String? // 상황 선택지 키 (없으면 voice 미생성)
  resolveKey   String? // 의연함 선택지 키
  createdAt    DateTime @default(now())

  @@unique([sessionId, votedDate]) // 1세션 1일 1회
  @@index([votedDate, emotion])
  @@index([votedDate, situationKey]) // 피드 조회용 (M4)
}

// 데일리 챌린지 상태 — 수락/완료/적립 포인트 추적 (P2)
// 익명 세션 기반(무가입 허용). 가입자는 userId 선택 연결. 1세션 1일 1챌린지.
model ChallengeState {
  id            String    @id @default(cuid())
  sessionId     String // 익명 세션 (웹: localStorage, 앱: 디바이스 ID)
  userId        String? // 가입자만 (선택)
  challengeDate String // YYYY-MM-DD (1일 1챌린지)
  accepted      Boolean   @default(false) // 챌린지 수락 여부
  completed     Boolean   @default(false) // 챌린지 완료 여부
  points        Int       @default(0) // 이 챌린지로 적립된 포인트
  acceptedAt    DateTime? // 수락 시각
  completedAt   DateTime? // 완료 시각
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([sessionId, challengeDate]) // 1세션 1일 1챌린지
  @@index([challengeDate])
}

// 일일 FOMO Index 스냅샷 — 파이프라인이 산출하여 저장
model FomoIndexSnapshot {
  id            String   @id @default(cuid())
  date          String   @unique // YYYY-MM-DD
  score         Int // 0~100
  state         String // "무관심"|"관망"|"관심"|"FOMO"|"광기"
  marketHeat    Int // 0~30
  communityHeat Int // 0~30
  emotionHeat   Int // 0~30
  whaleHeat     Int // 0~10
  aiSummary     String
  insights      Json // Daily Insights 배너 배열
  prevDayDelta  Int
  avg30Delta    Int
  createdAt     DateTime @default(now())
}

// 키워드 카드 일일 스냅샷 — KEYWORD_ENGINE_SPEC §4.5.
// cards = KeywordCard[] (점수순). confidence = 전체 산출 신뢰도(정직성 노출).
model KeywordCardSnapshot {
  id         String   @id @default(cuid())
  date       String   @unique // YYYY-MM-DD (KST)
  cards      Json // KeywordCard[] (점수순 정렬)
  confidence String // "high" | "medium" | "low" | "fallback"
  createdAt  DateTime @default(now())
}

// ─── 레거시 취향 학습 (읽기/마이그레이션 전용) ────────────────────────────────
// WO-M1 이후 신규 스와이프·뎁스 기록은 JudgmentLedger.user_action에만 append한다.
// 발견가가 없던 기존 행은 가격을 소급 생성하지 않으므로 원장 백필에서 제외한다.
enum TasteSubjectType {
  THEME // 키워드(섹터) 카드
  STOCK // 종목 카드 / 연관주
}

enum TasteSignalKind {
  MORE // 오른쪽 스와이프 = 관심
  LESS // 왼쪽 스와이프 = 덜 관심
  VIEW_DEPTH // 뎁스 열람 = 강한 관심
  TAP_RELATED // 연관주 탭 = 발굴 반응
}

model TasteSignal {
  id          String           @id @default(cuid())
  userId      String? // 로그인 유저(없으면 익명)
  sessionId   String? // 가입 전 익명 세션 — 로그인 시 userId로 연결
  subjectType TasteSubjectType
  subject     String // 키워드(테마)명 또는 종목명
  signal      TasteSignalKind
  createdAt   DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade) // 탈퇴 시 자동 삭제

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([subjectType, subject])
}

// FOMO Club 판단 원장 — 신호·판단·점수·선정·유저 행동·성과를 당시 가격과 함께 박제한다.
// 운영 DB에서는 JudgmentLedger 자체가 date RANGE 파티션 테이블이며, SQL 트리거가 UPDATE/DELETE를
// 항상 거부한다(prisma/sql/2026-07-20_judgment_ledger.sql). 애플리케이션은 create/find만 사용한다.
model JudgmentLedger {
  id             String   @default(cuid())
  date           String // YYYY-MM-DD (KST), 파티션 키
  ts             DateTime @default(now())
  asset          String // kr-stock | us-stock | coin | macro
  canonical      String
  symbol         String?
  kind           String // signal | verdict | score | selection | user_action | outcome
  payload        Json
  priceAt        Decimal  @db.Decimal(30, 10)
  actor          String // engine | committee | backfill | user:session:* | user:uid:*
  idempotencyKey String

  @@id([id, date])
  @@unique([idempotencyKey, date])
  @@index([date, kind])
  @@index([canonical, date])
  @@index([actor, date])
  @@map("JudgmentLedger")
}

// FOMO Club 품질 SLO 원장 — 일별 daily-30 스냅샷에서 결정론적으로 계산한 품질 지표를 박제한다.
// 운영 DB에서는 date RANGE 파티션 테이블이며, SQL 트리거가 UPDATE/DELETE를 항상 거부한다.
model QualityLedger {
  id             String   @default(cuid())
  date           String // YYYY-MM-DD (KST), 파티션 키
  ts             DateTime @default(now())
  idempotencyKey String // quality:YYYY-MM-DD
  payload        Json
  actor          String   @default("engine")

  @@id([id, date])
  @@unique([idempotencyKey, date])
  @@index([date])
  @@map("QualityLedger")
}

// 일별 투자자 수급(외국인·기관 순매매) 누적 — SUPPLY DEMAND SCORE HANDOFF §2.
// 시점 원칙: date = 장 마감 확정 거래일. 2~3주 쌓이면 "평소 대비 이례성"(z-score) 산출 토대.
// db push 게이트: prisma db push 는 오너 직접 승인. 테이블 전이라도 cron/라우트는 폴백(빈 값)으로 동작.
model SupplyDemandDaily {
  id             String   @id @default(cuid())
  ticker         String // 종목 코드(네이버/KRX 6자리)
  date           String // YYYY-MM-DD (장마감 확정 거래일)
  foreignNet     Float // 외국인 순매매량(주, +매수/-매도)
  institutionNet Float // 기관 순매매량(주, +매수/-매도)
  individualNet  Float? // 개인 순매매량(주). KIS Open API 만 제공(네이버 경로는 null)
  createdAt      DateTime @default(now())

  @@unique([ticker, date])
  @@index([ticker, date])
}

// ═══════════════════════════════════════════════════════════════════════════
// STRATEGY LAB — LAB-02 데이터 모델
//
// §0 원칙: **백테스트와 페이퍼가 같은 테이블에 쌓인다.** 따로 두면 비교할 수 없다.
// `Run.kind` 하나로 갈라진다.
//
// 필드 이름은 지시서의 snake_case(`strategy_id`·`entry_at`)를 이 레포 규약인
// camelCase 로 적었다. 컬럼도 camelCase 다 — 나머지 38개 모델이 전부 그렇고,
// 한 스키마에 두 규약을 섞으면 그게 더 나쁘다.
// ═══════════════════════════════════════════════════════════════════════════

/// 시장. 크립토 먼저 → 주식 → 폴리마켓 (LAB-00 §0).
enum Market {
  CRYPTO
  STOCK
  POLYMARKET
}

/// 전략 수명. **종료 전략도 표에 남긴다**(LAB-00 §7) — 지우는 상태가 없다.
enum StrategyState {
  DRAFT
  RUNNING
  PAUSED
  STOPPED
}

/// 실행 종류. `LEGACY` 는 판단 원장 이전분(LAB-02 PART C) — **순위에서 제외한다.**
enum RunKind {
  BACKTEST
  PAPER
  LIVE
  LEGACY
}

enum TradeSide {
  LONG
  SHORT
}

/// 청산 사유. 없으면 나중에 못 고친다(PART A-3).
enum ExitReason {
  STOP
  TARGET
  TIME
  SIGNAL
  MANUAL
}

/// 전략 정의. **규칙이 바뀌면 새 행을 만든다** — 기존 행을 수정하지 않는다.
/// 같은 `name` 의 `version` 이 올라간 새 행이 된다.
model Strategy {
  id         String        @id @default(cuid())
  name       String
  version    Int           @default(1)
  market     Market
  /// 규칙 JSON. 스키마는 `@fomo/lab` 의 `parseStrategyDefinition` 이 검증한다.
  /// **코드가 없다** — 함수·표현식 문자열 금지(PART B-1).
  definition Json
  status     StrategyState @default(DRAFT)

  createdAt  DateTime  @default(now())
  stoppedAt  DateTime?
  /// 왜 껐나. 종료 전략이 표에 남을 때 이 칸이 비어 있으면 기록이 거짓이 된다.
  stopReason String?

  runs Run[]

  /// 같은 이름의 같은 버전은 하나뿐이다. 규칙 변경은 버전을 올린다.
  @@unique([name, version])
  @@index([status, market])
}

/// 실행 인스턴스. **같은 전략을 백테스트와 페이퍼로 각각 돌리면 Run 이 둘 생긴다.**
model Run {
  id         String  @id @default(cuid())
  strategyId String
  kind       RunKind

  periodStart DateTime
  /// 페이퍼·라이브는 진행중이라 null 이다.
  periodEnd   DateTime?

  initialCapital Decimal @db.Decimal(30, 10)

  /// 어느 데이터로 돌렸나. 데이터가 바뀌면 결과가 바뀌므로 결과와 같이 박아둔다.
  dataVersion   String
  /// 엔진 버전. 같은 정의라도 엔진이 바뀌면 결과가 다르다.
  paramsVersion String

  createdAt DateTime @default(now())

  strategy Strategy    @relation(fields: [strategyId], references: [id])
  trades   Trade[]
  equity   Equity[]
  metric   Metric?
  paper    PaperState?

  @@index([strategyId, kind])
  @@index([kind, createdAt])
}

/// 체결 한 건 = **포지션 하나의 생애**(진입 → 청산). 낱개 주문이 아니다.
/// 레거시 `LegacyTrade` 는 낱개 주문이라 알갱이가 다르다 — 그래서 합치지 않았다.
model Trade {
  id     String    @id @default(cuid())
  runId  String
  symbol String
  side   TradeSide

  entryAt     DateTime
  entryPrice  Decimal  @db.Decimal(30, 10)
  /// 왜 들어갔나. **필수다.** 없으면 나중에 못 고친다(PART A-3).
  entryReason String

  /// null 이면 보유중.
  exitAt     DateTime?
  exitPrice  Decimal?    @db.Decimal(30, 10)
  exitReason ExitReason?

  qty      Decimal @db.Decimal(30, 10)
  fee      Decimal @default(0) @db.Decimal(30, 10)
  slippage Decimal @default(0) @db.Decimal(30, 10)
  /// 누적 펀딩비. 무기한 선물에서 이걸 빼면 수익률이 부풀려진다.
  funding  Decimal @default(0) @db.Decimal(30, 10)

  /// 실현 손익. 보유중이면 null — 0 으로 채우지 않는다.
  pnl    Decimal? @db.Decimal(30, 10)
  pnlPct Float?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, entryAt])
  @@index([runId, exitAt])
  @@index([symbol, entryAt])
}

/// 자산 스냅샷. 백테스트는 봉마다, 페이퍼는 일정 주기.
model Equity {
  id    String   @id @default(cuid())
  runId String
  at    DateTime

  /// 현금 + 평가액.
  equity     Decimal @db.Decimal(30, 10)
  cash       Decimal @db.Decimal(30, 10)
  unrealized Decimal @default(0) @db.Decimal(30, 10)
  /// 고점 대비 낙폭(음수 또는 0). 순위가 수익/낙폭이라 이 칸이 순위를 만든다.
  drawdown   Float   @default(0)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// 같은 Run 의 같은 시각은 한 점뿐이다.
  @@unique([runId, at])
  @@index([runId, at])
}

/// 집계. **매번 계산하지 않고 저장한다** — 화면이 빨라야 한다.
/// Run 당 하나. 다시 계산하면 덮어쓴다.
model Metric {
  runId      String   @id
  computedAt DateTime @default(now())

  cagr        Float?
  totalReturn Float?
  /// 최대 낙폭. 음수 또는 0.
  mdd         Float?
  /// 수익/낙폭. **순위는 이걸로 낸다**(LAB-00 §7) — 수익률 순위는 레버리지가 이긴다.
  cagrMdd     Float?

  sharpe  Float?
  sortino Float?

  trades       Int    @default(0)
  winRate      Float?
  profitFactor Float?

  avgHoldHours Float?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([cagrMdd])
}

/// 벤치마크 시세. **모든 화면에서 같은 기간 벤치마크를 옆에 둔다**(LAB-00 §7)
/// — +30% 가 좋은지 나쁜지 이것 없이는 모른다.
model Benchmark {
  id     String   @id @default(cuid())
  symbol String
  at     DateTime
  price  Decimal  @db.Decimal(30, 10)

  @@unique([symbol, at])
  @@index([symbol, at])
}

// ═══════════════════════════════════════════════════════════════════════════
// LAB-03 — 크립토 데이터 수집
//
// §0 결정 (2026-09-13):
//   봉·실시간·펀딩비  Binance 공개 API
//   고래              Hyperliquid (FCE 이식)
//   종목              BTC · ETH · SOL
//   주기              1시간 + 일봉
//   기간              3년
//
// 거래소가 §0 기본값(Hyperliquid)과 다른 이유는 실측이다 — Hyperliquid 의
// `candleSnapshot` 은 **최근 5,000봉(≈208일)만** 주고 과거 구간 요청에는 0봉을
// 돌려준다. 1시간봉 3년(26,280봉)이 물리적으로 불가능하다. §0 이 근거로 든
// "FCE에 이미 있음" 은 확인 결과 `onchain/hyperliquid/`(고래 수집기)였고
// FCE 의 봉·체결 어댑터는 `exchange/bitget/` 이다.
// 상세는 `docs/lab/DATA_SOURCES.md`.
// ═══════════════════════════════════════════════════════════════════════════

/// 봉 주기. 문자열로 두지 않는다 — 오타가 조용히 다른 시계열을 만든다.
enum CandleInterval {
  H1
  D1
}

/// OHLCV. **시각은 봉의 여는 시각이고 UTC 다**(하지 말 것 4 — 로컬 기준 저장 금지).
model Candle {
  id       String         @id @default(cuid())
  symbol   String
  interval CandleInterval
  /// 봉이 열리는 시각(UTC). 닫는 시각이 아니다.
  at       DateTime

  open   Decimal @db.Decimal(30, 10)
  high   Decimal @db.Decimal(30, 10)
  low    Decimal @db.Decimal(30, 10)
  close  Decimal @db.Decimal(30, 10)
  volume Decimal @db.Decimal(30, 10)

  /// 어디서 받았나. 소스를 갈아 끼울 때 섞이지 않게 한다.
  source String

  @@unique([symbol, interval, at])
  @@index([symbol, interval, at])
}

/// 펀딩비. 무기한 선물이면 필수 — 빼면 수익률이 부풀려진다. 8시간 주기.
model Funding {
  id     String   @id @default(cuid())
  symbol String
  at     DateTime
  /// 해당 구간 요율(비율). 0.0001 = 0.01%.
  rate   Decimal  @db.Decimal(20, 12)
  source String

  @@unique([symbol, at])
  @@index([symbol, at])
}

/// 최신 가격 한 점. **시계열은 `Candle` 이 진다**(PART B-1 "최신 가격만").
/// 심볼당 한 행이라 갱신만 일어난다.
model LatestPrice {
  symbol    String   @id
  price     Decimal  @db.Decimal(30, 10)
  /// 소스가 말한 시각.
  at        DateTime
  /// 우리가 받은 시각. `at` 과 벌어지면 소스가 늦는 것이다.
  fetchedAt DateTime @default(now())
  source    String

  @@index([fetchedAt])
}

/// 고래 포지션 변화 (PART C — Hyperliquid).
model WhalePosition {
  id      String   @id @default(cuid())
  address String
  symbol  String
  /// LONG | SHORT. 스냅샷 시점의 방향.
  side    String
  /// 명목 규모(USD).
  size    Decimal  @db.Decimal(30, 10)
  at      DateTime
  source  String

  /// 같은 주소·종목의 같은 스냅샷 시각은 한 행이다.
  @@unique([address, symbol, at])
  @@index([symbol, at])
  @@index([at])
}

/// 데이터 구멍. **메우지 않는다**(LAB-00 §7 · PART A-2).
/// 백테스트가 이 구간을 읽고 진입하지 않는다(LAB-04 PART D).
model DataGap {
  id         String         @id @default(cuid())
  symbol     String
  interval   CandleInterval
  /// 빠진 첫 봉의 시각.
  fromAt     DateTime
  /// 빠진 마지막 봉의 시각.
  toAt       DateTime
  /// 빠진 봉 개수.
  missing    Int
  detectedAt DateTime       @default(now())

  @@unique([symbol, interval, fromAt])
  @@index([symbol, interval, fromAt])
}

/// 수집 실행 기록. **2회 연속 실패하면 알린다**(PART E-1).
/// 알림 판정을 사람 기억이 아니라 이 표에서 한다.
model CollectionRun {
  id         String   @id @default(cuid())
  /// 잡 이름 — `candles` · `latest-price` · `funding` · `whale` · `benchmark`.
  job        String
  ok         Boolean
  startedAt  DateTime
  finishedAt DateTime @default(now())
  /// 넣거나 갱신한 행 수.
  rows       Int      @default(0)
  /// 실패 사유. 성공이면 null.
  error      String?
  /// 잡이 남긴 수치(종목별 건수·구멍 등). 화면·알림이 읽는다.
  detail     Json?

  @@index([job, finishedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// LAB-07 — 페이퍼 실행기
// ═══════════════════════════════════════════════════════════════════════════

/// 페이퍼 실행 상태. **중간에 죽어도 다음 실행에서 이어진다**(PART B-1).
///
/// `state` 는 `@fomo/lab` 의 `ExecutorState` 를 JSON 으로 담는다 —
/// 현금·보유 포지션·대기 신호·지표 창·고래 이력·마지막 종가.
/// **백테스트와 같은 실행기가 이걸 읽고 쓴다**(하지 말 것 1).
model PaperState {
  runId     String    @id
  state     Json
  /// 마지막으로 처리한 봉의 시각. 다음 실행은 이 뒤부터 본다.
  lastBarAt DateTime?
  updatedAt DateTime  @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
}

/// 중복 실행 방지 잠금 (PART B-2).
///
/// 같은 시각에 두 번 돌면 같은 봉으로 두 번 체결한다. 프로세스 기억이 아니라
/// **표**로 막는다 — 크론이 여러 러너에서 뜰 수 있고, 재배포가 겹칠 수 있다.
///
/// 임대(lease) 방식이다. `expiresAt` 이 지나면 죽은 잠금으로 보고 뺏는다 —
/// 그러지 않으면 한 번 죽은 실행이 **영원히** 다음 실행을 막는다.
model JobLock {
  job        String   @id
  holder     String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// LAB-BRIDGE — FCE 거울
//
// **랩은 엔진을 갖지 않는다.** 여기 있는 표는 전부 FCE 가 계산한 것을 받아 적는
// 자리다. 랩이 이 숫자로 무엇을 다시 계산하면 두 화면이 서로 다른 말을 하게 된다.
//
// 그래서 원칙이 하나다 — **계산하지 않는다. 조립한다.**
// (FCE 의 일일 리포트가 스스로에게 건 규칙과 같다.)
//
// 업로더는 `scripts/lab/fce-upload.ts` 이고 FCE API(127.0.0.1:8875)를 읽는다.
// FCE 레포는 건드리지 않는다.
// ═══════════════════════════════════════════════════════════════════════════

/// 업로드 한 번. **끊김 구간을 이 표로 잰다**(LAB-BRIDGE PART B-4).
/// 호스트가 자면 업로드가 멈추고, 그 공백이 화면에 그대로 보여야 한다.
model FceUpload {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  ok        Boolean
  /// 이번에 받아 적은 트랙·포지션 수.
  tracks    Int      @default(0)
  positions Int      @default(0)
  /// 실패 사유. 성공이면 null.
  error     String?
  ms        Int      @default(0)

  @@index([at])
}

/// 트랙 하나의 현재 상태. **키로 덮어쓴다** — 이력은 FCE 가 갖는다.
model FceTrack {
  /// crypto · whale · stock_us · stock_kr · polymarket
  key      String @id
  label    String
  currency String

  startingCapital Decimal  @db.Decimal(30, 10)
  /// 평가액. 산출 불가면 null — **0 으로 채우지 않는다**(폴리마켓이 그렇다).
  currentCapital  Decimal? @db.Decimal(30, 10)
  realized        Decimal? @db.Decimal(30, 10)
  unrealized      Decimal? @db.Decimal(30, 10)
  /// **실현 기준 수익률**(PART C-1). 미실현은 따로 둔다.
  returnPct       Float?

  trades       Int?
  winRatePct   Float?
  profitFactor Float?
  mddPct       Float?
  /// 표본이 모자라다는 FCE 의 판정. 순위·강조에 쓰면 안 된다.
  sampleNote   String?

  /// running · stopped · held · excluded
  status       String
  /// 정지·보류 사유. **비어 있으면 화면이 거짓이 된다**(LAB-00 §7).
  statusReason String?

  /// **레버리지를 숨기지 않는다**(PART D-2). MDD 가 배수에서 나온 숫자이기 때문이다.
  leverage Float?

  benchmarkLabel     String?
  benchmarkStart     Float?
  benchmarkCurrent   Float?
  /// FCE 가 낸 벤치마크 수익률. 시작·현재로 랩이 다시 계산하지 않는다.
  benchmarkReturnPct Float?
  /// 정지 근거 메모 — "왜 멈췄는지" 를 화면이 그대로 옮긴다.
  evidenceNote       String?

  /// **유효일.** 호스트가 자면 그 하루는 검증에 안 들어간다. FCE 가 재는 값이다.
  elapsedDays  Int?
  /// 달력일. 유효일과 나란히 놔야 "두 달치 성과" 로 안 읽힌다.
  calendarDays Int?

  /// FCE 가 이 숫자를 낸 시각. 업로드 시각과 다르다.
  asOf      DateTime
  updatedAt DateTime @updatedAt
}

/// 보유 포지션. 업로드마다 **트랙 단위로 지우고 다시 넣는다** — 닫힌 것이 남으면 안 된다.
model FcePosition {
  /// FCE 의 거래 id.
  id        String @id
  trackKey  String
  symbol    String
  /// long · short
  direction String

  leverage     Float?
  marginUsdt   Float?
  /// 증거금 대비 손익률. **−100% 아래로 갈 수 있다** — FCE 에 청산 모델이 없다(PART D-1).
  netReturnPct Float?
  healthScore  Int?

  entryAt    DateTime?
  entryPrice Float?

  /// UI-06 — 페이퍼 거래의 현재가·수량·비용. FCE `exit_monitor` · `open_trades[]` 값 그대로.
  markPrice      Float?
  quantity       Float?
  notionalUsdt   Float?
  /// 진입 이후 누적 수수료 + 펀딩. FCE 가 둘을 나누지 않고 한 칸(`costs_usdt`)으로 준다.
  costsUsdt      Float?
  unrealizedUsdt Float?
  timeframe      String?
  /// FCE 스탠스(`long_leaning` · `conflicted` …).
  stance         String?

  /// UI-06 가격 레일 — **FCE 페이퍼 포지션만**(광혁 결정 2026-09-26). LAB-08 의 목표가·손절선 금지는
  /// 랩 자체 엔진 포지션(`toLivePosition`)에 그대로 남는다. 라이브(Bitget 계좌) 포지션은 받지 않는다.
  invalidationPrice Float?
  /// 지금 걸린 손절선. 진입 땐 무효화와 같고, **부분 익절 뒤 본전으로 올라간다**(ADA 0.24599 → 0.2541).
  /// FCE 의 `invalidation_distance_pct` 가 이 선까지의 거리다 — 레일 왼쪽 끝은 이것이다.
  stopPrice         Float?
  takeProfitPrice   Float?
  takeProfit2Price  Float?
  /// 현재가에서 각 선까지(%). FCE `exit_monitor.*_distance_pct`.
  invalidationDistancePct Float?
  takeProfitDistancePct   Float?

  asOf DateTime

  @@index([trackKey, asOf])
}

/// UI-06 캔들 차트 — 열린 페이퍼 포지션 심볼의 시간봉별 캔들. Mac 업로더가 Bitget 공개 시세에서 받아 통째로 갈아 끼운다.
/// 시세(시장 데이터)라 계좌 정보가 없다.
model FcePositionChart {
  symbol    String
  /// `15m` · `1h` · `4h` · `1d`
  timeframe String
  /// `[t(초), o, h, l, c][]` — 오래된 것부터.
  candles   Json
  asOf      DateTime

  @@id([symbol, timeframe])
}

/// 닫힌 거래 한 건.
///
/// 포지션과 달리 **지우고 다시 넣지 않는다.** 닫힌 거래는 사실이고, FCE 가 보관
/// 기간을 줄이거나 리셋해도 랩에는 남아야 한다. 같은 id 로 다시 오면 덮어쓴다.
///
/// ## 목표가·손절선은 받지 않는다
///
/// FCE 응답에는 `take_profit_price` · `stop_price` · `invalidation_price` ·
/// `target_plan` 이 들어 있다. **가져오지 않는다** — `LAB-08` 이 화면에서 막은 바로
/// 그 값들이고, 받아두면 언젠가 화면에 샌다. 여기 있는 것은 **결과**뿐이다:
/// 얼마에 들어가 얼마에 나왔고 왜 나왔나.
model FceTrade {
  /// FCE 의 거래 id.
  id         String  @id
  trackKey   String
  symbol     String
  /// long · short
  direction  String
  /// crypto · stock · ...
  assetClass String?
  timeframe  String?

  leverage   Float?
  marginUsdt Float?

  entryAt    DateTime?
  entryPrice Float?
  exitAt     DateTime?
  exitPrice  Float?

  /// 비용 전.
  grossPnlUsdt Float?
  /// 수수료·펀딩비. **빼지 않으면 성과가 부풀려진다.**
  costsUsdt    Float?
  netPnlUsdt   Float?
  /// 증거금 대비.
  netReturnPct Float?

  /// 왜 나왔나. 닫힌 거래의 **사실**이다 — 열린 포지션의 출구 조건과 다르다.
  exitReason  String?
  /// FCE 가 붙인 패배 태그.
  lossTags    Json?
  holdingBars Int?

  asOf DateTime

  @@index([trackKey, exitAt])
  @@index([exitAt])
}

/// 트랙 자본 한 점. **Overview 차트의 재료** (UI-02 B-2).
///
/// ## FCE 에는 이 이력이 없다
///
/// 트랙 테이블은 `cash` 를 덮어쓴다 — 어제 얼마였는지가 아무 데도 없다
/// (`docs/ui/DATA_SOURCES.md` §3). 그래서 거래 이력의 **실현 손익을 누적**해
/// 되만든다. 되만든 점은 `source = "reconstructed"` 이고 **화면이 그 사실을 띄운다.**
///
/// 재구성한 곡선은 실측과 다르다: 미실현이 빠지고, 거래가 닫히는 순간에만 값이
/// 변해 계단이 된다. 그걸 실측인 것처럼 그리면 화면이 거짓말한다.
model FceCapitalPoint {
  id       String @id @default(cuid())
  trackKey String
  at       DateTime

  /// 트랙 **원래 통화** 기준. $10,000 환산은 화면이 한다(UI-02 C).
  capital Float
  /// 같은 시각 벤치마크. 없으면 null — **0 으로 채우지 않는다.**
  benchmark Float?

  /// `fce` = FCE 가 낸 값 · `reconstructed` = 거래 이력으로 되만든 값.
  source String

  /// 같은 트랙의 같은 시각은 한 점이다.
  @@unique([trackKey, at])
  @@index([trackKey, at])
}

/// FCE 가 "관측이 부족했다" 고 판정한 날 (UI-04 C-2).
///
/// ## 왜 따로 받나 — 평평한 선은 두 가지 뜻이다
///
/// 자본 곡선은 실현 손익 기준이라 거래가 없으면 평평하다. 그런데 평평한 구간에는
/// **"아무 일도 없었다"** 와 **"안 보고 있었다"** 가 섞여 있다. 크립토는 78일 중 49일이
/// 관측 임계(90%)에 못 미쳤다 — 호스트가 자고 있었다.
///
/// FCE 가 이미 잰다(`/api/system/paper/diagnosis` → `observation_integrity`). 랩은 받아서
/// 차트에 회색 띠로 그린다. **FCE 의 판정이라 업로드마다 트랙 단위로 통째로 바꾼다.**
model FceLostDay {
  trackKey    String
  /// `2026-07-09` — FCE 가 일 단위로 판정한다.
  day         String
  coveragePct Float
  /// FCE 가 적은 사유. "커버리지 58.33% < 임계 90.0% · 최장 공백 209분".
  reason      String

  @@id([trackKey, day])
}

/// 화면 하나가 통째로 들어 있는 조립본 (UI-02 F-1).
///
/// ## 왜 있나 — 왕복 한 번이 ~900ms 다
///
/// 정규 도메인에서 실측했다:
///
/// ```
/// 쿼리 2개  →  1,793ms
/// 쿼리 1개  →    904ms
/// ```
///
/// 원격 DB 왕복이 응답 시간의 전부다. `Promise.all` 로 감싸도 줄지 않는다 —
/// 한 커넥션에서 차례로 간다. 그래서 **API 하나가 쿼리 하나**가 되게 만든다.
/// Overview 는 11.9초였다(쿼리 ~11개).
///
/// 조립은 **쓰기 시점**에 한다 — 업로드가 끝나면 여섯 탭을 통째로 만들어 넣는다.
/// `UI-02 F-1` 이 "요청 시점에 계산하지 않는다" 고 한 것이 이것이다.
///
/// ## 낡으면 화면이 말한다
///
/// `builtAt` 을 같이 낸다. 업로드가 멈추면 조립본도 멈추고, 동기화 상태(PART G)가
/// 그 사실을 이미 띄우고 있다.
model LabSnapshot {
  /// overview · strategies · positions · whales · research · journal
  key     String   @id
  payload Json
  builtAt DateTime @updatedAt
}

/// 연구 항목 — **랩이 새로 갖는 유일한 데이터** (UI-02 PART E).
///
/// FCE 에 없다. 무엇을 확인하고 있고 무엇을 알아냈는지는 엔진이 아니라 사람이
/// 갖는 기록이다.
///
/// 편집은 지금 파일로 한다 — `docs/lab/research/*.md` 를 시드가 읽어 넣는다.
/// 편집 UI 는 나중이다.
model Research {
  /// `01` · `02` — 화면에 그대로 나가는 번호.
  no    String @id
  title String

  /// open · testing · blocked · closed
  status String
  /// 닫혔을 때의 답. yes · no · inconclusive.
  verdict String?

  /// 한 줄 요약. 목록에서 제목 밑에 뜬다.
  summary String

  hypothesis String?
  /// 어떻게 확인하나.
  method     String?
  /// 근거 수치와 출처. `[{ label, value, source }]`.
  evidence   Json?
  /// 그래서 무엇을 하기로 했나.
  decision   String?
  /// 이것 때문에 막혀 있는 것. 예: 실매매.
  blocks     String?

  openedAt DateTime
  closedAt DateTime?
  /// 관련 트랙 키 배열.
  trackKeys Json?

  updatedAt DateTime @updatedAt

  @@index([status])
}

/// 고래 분석. 단일 행으로 덮어쓴다.
model FceWhale {
  id Int @id @default(1)

  walletsTotal Int
  eligible     Int
  /// 탈락 사유 분포 — MM · 표본 미달 · 승률 미달.
  rejected     Json
  /// 통과한 지갑 주소.
  passers      Json

  /// 추종 트랙 성적. **고래 자신의 승률과 다른 모집단이다**(docs/lab/WHALE_GAP.md).
  followWinPct  Float?
  followTrades  Int?
  followPf      Float?
  followNetUsdt Float?

  /// 진입 지연(분)·드리프트(손절폭 대비 %) 분포. FCE 가 이미 재고 있다.
  latency Json?
  drift   Json?

  asOf DateTime
}
