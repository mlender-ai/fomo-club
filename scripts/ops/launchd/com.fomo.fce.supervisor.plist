<?xml version="1.0" encoding="UTF-8"?>
<!--
  FCE 감시 루프(`~/fce/scripts/local/supervisor.sh`)를 launchd 로 상시화한다 (OPS-01 STEP 3).

  감시 루프는 FCE 것이다 — 8875 백엔드 · 8876 프론트가 죽거나 매달리면 다시 띄운다.
  지금까지는 `start-supervisor.sh` 가 nohup 으로 띄워서 재부팅하면 죽었다. 여기서는 launchd 가
  그 루프를 띄우고, 루프가 죽으면 launchd 가 다시 띄운다. **FCE 코드는 그대로다.**

  FCE 가 `~/Documents` 아래 있으면 launchd 는 못 읽는다(TCC) — 그래서 `~/fce` 로 옮긴 뒤에만 올린다.

  설치: scripts/ops/launchd/install-fce.sh
  제거: launchctl bootout gui/$(id -u)/com.fomo.fce.supervisor
        rm ~/Library/LaunchAgents/com.fomo.fce.supervisor.plist
  로그: ~/fce/logs/supervisor.log · backend.log · frontend.log (FCE 가 쓰는 자리) · launchd.log (이 루프의 표준 출력)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fomo.fce.supervisor</string>

  <!--
    pid 파일을 쓰고 exec 한다 — FCE 의 start/stop-supervisor.sh 가 이 파일을 본다.
    같은 pid 를 쓰므로 `start-supervisor.sh` 를 실수로 또 돌려도 "이미 실행 중" 으로 끝난다.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>mkdir -p "__FCE__/logs" &amp;&amp; echo $$ &gt; "__FCE__/logs/supervisor.pid" &amp;&amp; exec /bin/bash "__FCE__/scripts/local/supervisor.sh"</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__FCE__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
__EXTRA_ENV__
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- /tmp 는 재부팅에 지워진다 — FCE 로그 폴더에 둔다. -->
  <key>StandardOutPath</key>
  <string>__FCE__/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__FCE__/logs/launchd.log</string>
</dict>
</plist>
