# /etc/fomo/fce-secrets.env — 🧑 사람이 넣는다. root 소유 0600. 에이전트는 값을 보지 않는다 (OPS-04 C-2).
#
#   sudo install -m 600 -o root -g root /dev/null /etc/fomo/fce-secrets.env
#   sudo nano /etc/fomo/fce-secrets.env
#
# ── Bitget — **조회 전용 키만** (C-1). 새로 만든다. 맥 .env 의 키를 복사하지 않는다.
#    Bitget → API 관리 → 새 키: 권한 "읽기 전용(Read-only)" 하나 · 거래 ✗ · 출금 ✗ · IP 제한 = 서버 공인 IP(C-3)
#    페이퍼는 주문 키가 필요 없다. 이 키는 계좌 포지션 조회(FCE 로컬 UI 건강도)에만 쓰인다 — 없어도 페이퍼는 돈다.
FCE_BITGET_API_KEY=
FCE_BITGET_API_SECRET=
FCE_BITGET_API_PASSPHRASE=

# ── 토스 OpenAPI — FCE 는 시세 조회 경로만 부른다(`TossReadOnlyClient` 허용 경로 = 시세 · 호가 · 봉 · 종목).
#    ⚠ 토큰을 새로 받으면 **앞 토큰이 무효가 된다**(FCE toss/client.py). 맥과 같은 앱 자격증명을 그림자 서버에 넣으면
#      두 기계가 서로의 토큰을 끊어 **맥 운영 주식 트랙이 인증 실패**한다.
#      → 그림자 주: 토스 콘솔에서 **서버용 앱을 따로** 만들 수 있으면 그 값 · 없으면 비워 둔다(서버 주식 트랙은 대조 제외)
#      → 운영 전환 때: 맥 FCE 를 멈춘 뒤 운영 앱 값을 넣고, 토스 허용 IP 에 서버 IP 추가
FCE_TOSS_CLIENT_ID=
FCE_TOSS_CLIENT_SECRET=

# ── 텔레그램 봇 — **운영 전환 뒤에만.** 그림자 주에는 비워 둔다(맥 봇과 충돌 · fce-shadow.env 가 봇도 끈다).
FCE_TELEGRAM_BOT_TOKEN=
FCE_TELEGRAM_CHAT_ID=

# ── 선택 — 맥에 있던 것만
FCE_COINGLASS_API_KEY=
FCE_OPENAI_API_KEY=
