# /etc/fomo/runner.env — 러너 · 그림자 기록 · 대조가 같이 읽는다. 비밀 아님.
LAB_BASE_URL=https://fomo-web-mlender-ais-projects.vercel.app
# 쓰는 이름 — Vercel LAB_WRITER 가 이 값이면 이 서버만 원장에 쓴다(apps/web/lib/lab/writer.ts). 영문·숫자·- 만.
LAB_WRITER_ID=seoul-1
FCE_HOME=/opt/fce
FCE_PYTHON=/opt/fce/.venv/bin/python
FCE_BASE_URL=http://127.0.0.1:8875
SHADOW_DIR=/var/lib/fomo/shadow
# 그림자 시작 시각 — migrate-db-from-mac.sh 가 알려 준 값으로 install.sh 가 채운다(ISO · UTC).
SHADOW_SINCE=
HOME=/var/lib/fomo
TZ=Asia/Seoul
