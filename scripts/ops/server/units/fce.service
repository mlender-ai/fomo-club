# FCE 백엔드 (uvicorn :8875) — OPS-04 PART B · E
#
# 맥의 com.fomo.fce.supervisor 자리다. 워커(APScheduler)는 이 프로세스 안에서 돈다.
# FCE 코드는 그대로 — 설치·설정만(`/opt/fce` 는 FCE 레포 클론).
#
# 재시작: 죽으면 10초 뒤. 5분에 5번 넘게 죽으면 멈추고 fomo-alert@ 이 알린다(E).
[Unit]
Description=FCE backend (uvicorn 127.0.0.1:8875)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=fomo-alert@%n.service

[Service]
Type=simple
User=fomo
Group=fomo
# .env · 상대 DB 경로가 cwd 기준이다(맥 run-backend.sh 와 같다).
WorkingDirectory=/opt/fce/backend
# 운영 값(비밀 아님) → 비밀(🧑 사람이 넣는다 · root 0600 — systemd 가 root 로 읽고 넘긴다).
EnvironmentFile=/etc/fomo/fce.env
EnvironmentFile=-/etc/fomo/fce-secrets.env
ExecStart=/opt/fce/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8875
Restart=always
RestartSec=10
# 맥에서 파일 한도 256 때문에 /health 가 24번 중 21번 리셋됐다(OPS-01 · 97b2ea3).
LimitNOFILE=65536
StandardOutput=append:/var/log/fomo/fce.log
StandardError=append:/var/log/fomo/fce.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
